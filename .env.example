# Streamlit AI Workspace secrets
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mqn98sf.mongodb.net/enterprise_ai_db?retryWrites=true&w=majority
MONGODB_DATABASE=enterprise_ai_db
AUTH_MONGODB_DATABASE=enterprise_ai_db
# This username receives admin access only after its private bootstrap token is verified.
ADMIN_USERNAME=admin
# Generate a random secret of at least 32 characters; never commit the real value.
ADMIN_BOOTSTRAP_TOKEN=
GEMINI_API_KEY=replace-with-your-gemini-api-key
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HF_API_TOKEN=replace-with-your-huggingface-token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LTX_API_KEY=
FAL_KEY=
# GEMINI_KEY_1-16 takes precedence; otherwise JSON arrays, numbered keys, then base keys are used.
# Values are never written to logs.
GEMINI_API_KEYS=["replace-with-gemini-key-1","replace-with-gemini-key-2"]
HF_TOKENS=["replace-with-hf-token-1","replace-with-hf-token-2"]
# Preferred Gemini variables; populated entries are tried in numeric order (1–16).
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
GEMINI_KEY_6=
GEMINI_KEY_7=
GEMINI_KEY_8=
GEMINI_KEY_9=
GEMINI_KEY_10=
GEMINI_KEY_11=
GEMINI_KEY_12=
GEMINI_KEY_13=
GEMINI_KEY_14=
GEMINI_KEY_15=
GEMINI_KEY_16=
# Backward-compatible Gemini names are used when no GEMINI_KEY_n values are set.
HF_TOKEN_1=
HF_TOKEN_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
HF_VIDEO_SPACE=Wan-AI/Wan2.1
HF_VIDEO_API_NAME=
# Match this JSON array to the Space API; {duration_seconds} is replaced with 5.
HF_VIDEO_INPUTS_JSON=["{prompt}"]
GEMINI_MODEL=gemini-3.8-flash
HF_IMAGE_API_URL=https://api-inference.huggingface.co/models/black-forest-labs/FLUX.1-schnell
HF_VIDEO_API_URL=https://api-inference.huggingface.co/models/damo-vilab/text-to-video-ms-1.7b
HF_TEXT_API_URL=https://api-inference.huggingface.co/models/google/flan-t5-large
# Set the Space IDs and API names from each Space's "Use via API" panel.
HF_TEXT_TO_VIDEO_SPACE=
HF_TEXT_TO_VIDEO_API_NAME=
HF_TEXT_TO_VIDEO_INPUTS=["{prompt}"]
HF_IMAGE_TO_VIDEO_SPACE=
HF_IMAGE_TO_VIDEO_API_NAME=
HF_IMAGE_TO_VIDEO_INPUTS=["{image}", "{prompt}"]
HF_STYLE_TRANSFER_SPACE=
HF_STYLE_TRANSFER_API_NAME=
HF_STYLE_TRANSFER_INPUTS=["{image}", "{prompt}"]
# Video-to-video Space API; match the argument order shown in its "Use via API" panel.
HF_VIDEO_TO_VIDEO_SPACE=
HF_VIDEO_TO_VIDEO_API_NAME=
HF_VIDEO_TO_VIDEO_INPUTS_JSON=["{video}", "{prompt}"]
