# Example environment variables for the FastAPI backend
API_V1_STR=/api/v1
PROJECT_NAME=AI Workspace Backend
# Required: generate a unique random value of at least 32 characters.
JWT_SECRET=
AI_GATEWAY_MODE=dev
PAID_PROVIDERS_ENABLED=false
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
OPENROUTER_MODEL=openrouter/free
# Tavily keys must stay server-side; provision separate, authorized accounts only.
TAVILY_API_KEY_1=
TAVILY_API_KEY_2=
TAVILY_REQUEST_TIMEOUT_SECONDS=30
TAVILY_TECHNICAL_FAILOVER_ENABLED=true
AI_SEARCH_DAILY_QUOTA=20
AI_EXTRACTION_DAILY_QUOTA=20
AI_RESEARCH_DAILY_QUOTA=10
TAVILY_MONTHLY_BUDGET_CREDITS=0
AI_DAILY_QUOTA=100
AI_PER_CHAT_QUOTA=20
AI_IMAGE_DAILY_QUOTA=20
AI_VIDEO_DAILY_QUOTA=20
AI_RESERVATION_TIMEOUT_SECONDS=900
HF_TEXT_API_URL=https://router.huggingface.co/v1/chat/completions
HF_TEXT_MODEL=
HF_IMAGE_API_URL=https://router.huggingface.co/hf-inference/models/black-forest-labs/FLUX.1-schnell
HF_IMAGE_EDIT_SPACE=
HF_IMAGE_EDIT_API_NAME=
HF_IMAGE_EDIT_INPUTS_JSON=["{image}", "{prompt}"]
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_PRIMARY_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_IMAGE_FAST_MODEL=@cf/black-forest-labs/flux-1-schnell
LTX_API_KEY=
LTX_API_BASE_URL=https://api.ltx.video/v1
FAL_KEY=
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
POLLINATIONS_AUDIO_MODEL=openai/tts-1
FAL_VIDEO_MODEL=fal-ai/cogvideox-5b
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mqn98sf.mongodb.net/enterprise_ai_db?retryWrites=true&w=majority
MONGODB_DATABASE=enterprise_ai_db
# This username receives admin access only after its private bootstrap token is verified.
ADMIN_USERNAME=admin
# Generate a random secret of at least 32 characters; never commit the real value.
ADMIN_BOOTSTRAP_TOKEN=
# JSON key arrays take precedence; numbered credentials and base variables remain supported.
GEMINI_API_KEYS=["replace-with-gemini-key-1","replace-with-gemini-key-2"]
HF_TOKENS=["replace-with-hf-token-1","replace-with-hf-token-2"]
# Preferred Gemini variables; populated entries are tried in numeric order (1–16).
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
GEMINI_KEY_6=
GEMINI_KEY_7=
GEMINI_KEY_8=
GEMINI_KEY_9=
GEMINI_KEY_10=
GEMINI_KEY_11=
GEMINI_KEY_12=
GEMINI_KEY_13=
GEMINI_KEY_14=
GEMINI_KEY_15=
GEMINI_KEY_16=
# Backward-compatible Gemini names are used when no GEMINI_KEY_n values are set.
HF_API_TOKEN=
HF_TOKEN_1=
HF_TOKEN_2=
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
HF_VIDEO_SPACE=Wan-AI/Wan2.1
HF_VIDEO_API_NAME=
HF_VIDEO_INPUTS_JSON=["{prompt}"]
# Configure a video-to-video Space and its API input order for the Advanced Video Studio.
HF_VIDEO_TO_VIDEO_SPACE=
HF_VIDEO_TO_VIDEO_API_NAME=
HF_VIDEO_TO_VIDEO_INPUTS_JSON=["{video}", "{prompt}"]
