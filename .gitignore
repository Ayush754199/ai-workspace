# Local throwaway QA harnesses and one-off helper scripts.
# Scoped to the repository ROOT only (leading slash) and to a leading
# underscore in the file NAME -- a bare ``_*.*`` also matches ``__init__.py``
# at every depth and would silently drop Python packages from the repo.
/_*.*
/_e2e/
/_perf_harness/
qa_360_*.cjs
qa_*_inspect.mjs
qa_browser_*.cjs
qa_browser_*.mjs
qa_probe_page.mjs
qa_pwa_*.cjs
qa_pwa_*.mjs
qa_pwa_*.ps1
qa_pwa_*.html
qa_pwa_*.py
qa_*_measure.html
qa_mobile_*.html
